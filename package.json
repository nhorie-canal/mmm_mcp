{
  "name": "mmm-mcp-server",
  "version": "0.1.3",
  "mcpName": "io.github.nhorie-canal/mmm-mcp-server",
  "description": "Matryoshka Mind Map の自分のデータをClaudeから直接読み書きするMCPサーバー",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhorie-canal/mmm_mcp.git"
  },
  "homepage": "https://github.com/nhorie-canal/mmm_mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mindmap",
    "todo",
    "claude",
    "matryoshka"
  ],
  "type": "module",
  "bin": {
    "mmm-mcp-server": "dist/src/server.js",
    "mmm-login": "dist/bin/login.js"
  },
  "files": [
    "dist/src",
    "dist/bin",
    "!dist/**/*.test.js"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "login": "node dist/bin/login.js",
    "test": "npm run build && node --test \"dist/src/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "open": "^10.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
